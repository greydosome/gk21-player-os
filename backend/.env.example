APP_NAME=GK21
APP_ENV=dev
API_HOST=0.0.0.0
API_PORT=8000

DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=gk21
DB_USER=gk21_app
DB_PASSWORD=change_me

# Keep disabled until HTTPS, app authentication, and additive migration are ready.
APP_AUTH_ENABLED=false
APP_AUTH_USER=gk21
# SHA-256 of a high-entropy random password, never a human-chosen weak password.
APP_AUTH_PASSWORD_SHA256=
APPLE_HEALTH_ENABLED=false
APPLE_HEALTH_COACHING_ENABLED=false
# Separate high-entropy upload-only bearer token; store only its SHA-256 here.
APPLE_HEALTH_TOKEN_SHA256=

# Independent random server-only signing secret (32+ characters). Rotate to revoke browser sessions.
APP_SESSION_SECRET=
