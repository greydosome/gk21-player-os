[Unit]
Description=Renew GK21 IP HTTPS certificate
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# Confirm certbot's installed absolute path before installing this template.
ExecStart=/usr/bin/certbot renew --cert-name 217.142.230.185 --quiet --deploy-hook "/usr/sbin/nginx -t && /usr/bin/systemctl reload nginx"
