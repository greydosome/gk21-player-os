# REVIEW TEMPLATE: merge into existing nginx configuration only after approval.
# Requires ngx_http_auth_request_module (check nginx -V), Certbot >=5.4.
# Both upstreams must bind to 127.0.0.1, never expose ports 3000/8000.
limit_req_zone $binary_remote_addr zone=gk21_health:10m rate=6r/m;
limit_req_zone $binary_remote_addr zone=gk21_login:10m rate=5r/m;
server {
    listen 80;
    server_name 217.142.230.185;
    location ^~ /.well-known/acme-challenge/ {
        root /var/www/letsencrypt;
        default_type text/plain;
        try_files $uri =404;
    }
    location /api/ { return 403; }
    location / { return 301 https://217.142.230.185$request_uri; }
}
server {
    listen 443 ssl;
    server_name 217.142.230.185;
    ssl_certificate /etc/letsencrypt/live/217.142.230.185/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/217.142.230.185/privkey.pem;
    client_max_body_size 32k;
    add_header Cache-Control "no-store" always;
    location = /_gk21_auth {
        internal;
        proxy_pass http://127.0.0.1:8000/api/auth/check;
        proxy_pass_request_body off;
        proxy_set_header Content-Length "";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Cookie $http_cookie;
        proxy_set_header Authorization $http_authorization;
    }
    location = /login {
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
    }
    location = /api/auth/login {
        limit_req zone=gk21_login burst=3 nodelay;
        limit_req_status 429;
        client_max_body_size 1k;
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        access_log off;
    }
    location = /api/integrations/apple-health/daily {
        limit_req zone=gk21_health burst=5 nodelay;
        limit_req_status 429;
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Authorization $http_authorization;
        access_log off;
    }
    # All APIs go to FastAPI, not the Next proxies. Cookies/Authorization pass through.
    location /api/ {
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Authorization $http_authorization;
    }
    location / {
        auth_request /_gk21_auth;
        error_page 401 = @login;
        proxy_pass http://127.0.0.1:3000;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
    }
    location @login { return 302 /login; }
}
